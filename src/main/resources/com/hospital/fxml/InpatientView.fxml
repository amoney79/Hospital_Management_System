<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.hospital.controllers.InpatientController"
    spacing="16" style="-fx-padding: 24;">
    <Label text="Inpatient Details" styleClass="page-title"/>

    <HBox spacing="12">
        <Label text="Ward:"/>
        <Label fx:id="wardLabel"/>
    </HBox>

    <HBox spacing="12">
        <Label text="Bed Number:"/>
        <Label fx:id="bedLabel"/>
    </HBox>

    <HBox spacing="12">
        <Label text="Admission Date:"/>
        <Label fx:id="admissionDateLabel"/>
    </HBox>

    <HBox spacing="12">
        <Label text="Doctor Assigned:"/>
        <Label fx:id="doctorLabel"/>
    </HBox>
</VBox>
