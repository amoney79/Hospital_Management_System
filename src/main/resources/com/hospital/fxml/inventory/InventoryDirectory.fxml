<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.hospital.inventory.DirectoryController" 
      spacing="24" style="-fx-padding: 32;" styleClass="main-content">
    
    <!-- Page Header -->
    <HBox alignment="BOTTOM_LEFT" spacing="10">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Inventory" styleClass="breadcrumb"/>
                <FontIcon iconLiteral="fth-chevron-right" iconSize="16" styleClass="breadcrumb-icon"/>
                <Label text="Directory" styleClass="breadcrumb-active"/>
            </HBox>
            <Label text="Inventory Directory" styleClass="page-title"/>
            <Label text="Real-time oversight of surgical, pharmaceutical, and consumable supplies." styleClass="page-subtitle"/>
        </VBox>
        <Button text="Add New Item" styleClass="btn btn-primary" graphicTextGap="8">
            <graphic>
                <FontIcon iconLiteral="fth-plus" iconSize="16"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Stats Overview -->
    <HBox spacing="16">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Total Items" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="14,208" styleClass="stat-value"/>
                <Label text="↑ 2.4%" styleClass="stat-indicator-positive"/>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Low Stock Alerts" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="12" styleClass="stat-value stat-error"/>
                <Label text="CRITICAL" styleClass="badge badge-error"/>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Expiring Soon" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="84" styleClass="stat-value"/>
                <Label text="Next 30 days" styleClass="stat-indicator-neutral"/>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Pending Orders" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="06" styleClass="stat-value"/>
                <Label text="View Track" styleClass="stat-action-link"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Filter Controls -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filter-bar">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="filter-group">
            <FontIcon iconLiteral="fth-filter" iconSize="20" styleClass="filter-icon"/>
            <Label text="Filter By" styleClass="filter-label"/>
            <ComboBox promptText="All Categories" styleClass="filter-combo"/>
        </HBox>
        <ComboBox promptText="All Stock Levels" styleClass="filter-combo"/>
        <ComboBox promptText="Any Expiration" styleClass="filter-combo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Clear All Filters" styleClass="btn btn-ghost">
            <graphic>
                <FontIcon iconLiteral="fth-refresh-ccw" iconSize="16"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Main Data Grid -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card">
        <TableView fx:id="directoryTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colItemName" text="ITEM NAME" prefWidth="250"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="120"/>
                <TableColumn fx:id="colSku" text="SKU / BARCODE" prefWidth="150"/>
                <TableColumn fx:id="colStockLevel" text="STOCK LEVEL" prefWidth="100"/>
                <TableColumn fx:id="colExpiration" text="EXPIRATION" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_BETWEEN" styleClass="pagination-bar" style="-fx-padding: 16;">
            <Label text="Showing 1 - 25 of 1,402 items" styleClass="text-sm text-muted"/>
            <HBox spacing="4" alignment="CENTER">
                <Button text="&lt;" styleClass="btn btn-outline btn-sm" disable="true"/>
                <Button text="1" styleClass="btn btn-primary btn-sm"/>
                <Button text="2" styleClass="btn btn-ghost btn-sm"/>
                <Button text="3" styleClass="btn btn-ghost btn-sm"/>
                <Label text="..." styleClass="text-sm text-muted"/>
                <Button text="56" styleClass="btn btn-ghost btn-sm"/>
                <Button text="&gt;" styleClass="btn btn-outline btn-sm"/>
            </HBox>
        </HBox>
    </VBox>
</VBox>
