<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.hospital.inventory.InventoryModuleController"
    stylesheets="@../../css/styles.css" styleClass="root">

    <!-- Custom Title Bar -->
    <top>
        <HBox alignment="CENTER_RIGHT" styleClass="title-bar"
            onMouseDragged="#handleTitleBarDragged" onMousePressed="#handleTitleBarPressed">
            <HBox alignment="CENTER" spacing="5" styleClass="window-controls">
                <Button mnemonicParsing="false" onMouseClicked="#handleMinimize"
                    styleClass="window-btn window-btn-min">
                    <graphic>
                        <FontIcon iconLiteral="fth-minus" />
                    </graphic>
                </Button>
                <Button mnemonicParsing="false" onMouseClicked="#handleMaximize"
                    styleClass="window-btn window-btn-max">
                    <graphic>
                        <FontIcon iconLiteral="fth-square" />
                    </graphic>
                </Button>
                <Button mnemonicParsing="false" onMouseClicked="#handleClose"
                    styleClass="window-btn window-btn-close">
                    <graphic>
                        <FontIcon iconLiteral="fth-x" />
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- Side Navigation -->
    <left>
        <VBox styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand-container">
                <StackPane styleClass="brand-icon-container">
                    <FontIcon iconLiteral="fth-x" iconSize="20" styleClass="brand-icon" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Central Clinical" styleClass="brand-title" />
                    <Label text="Inventory Hub" styleClass="brand-subtitle" />
                </VBox>
            </HBox>

            <VBox spacing="4" styleClass="nav-menu" VBox.vgrow="ALWAYS">
                <HBox fx:id="navDashboard" styleClass="nav-item" onMouseClicked="#handleNavClick">
                    <FontIcon iconLiteral="fth-grid" iconSize="20" styleClass="nav-icon" />
                    <Label text="Dashboard" styleClass="nav-text" />
                </HBox>
                <HBox fx:id="navDirectory" styleClass="nav-item nav-item-active"
                    onMouseClicked="#handleNavClick">
                    <FontIcon iconLiteral="fth-book" iconSize="20" styleClass="nav-icon" />
                    <Label text="Directory" styleClass="nav-text" />
                </HBox>
                <HBox fx:id="navOrders" styleClass="nav-item" onMouseClicked="#handleNavClick">
                    <FontIcon iconLiteral="fth-shopping-cart" iconSize="20" styleClass="nav-icon" />
                    <Label text="Orders" styleClass="nav-text" />
                </HBox>
                <HBox fx:id="navMaintenance" styleClass="nav-item" onMouseClicked="#handleNavClick">
                    <FontIcon iconLiteral="fth-tool" iconSize="20" styleClass="nav-icon" />
                    <Label text="Maintenance" styleClass="nav-text" />
                </HBox>
            </VBox>

            <VBox spacing="4" styleClass="nav-footer">
                <Button text="Quick Reorder" styleClass="btn btn-primary" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fth-refresh-cw" iconSize="16" />
                    </graphic>
                </Button>
                <HBox fx:id="navSettings" styleClass="nav-item" onMouseClicked="#handleNavClick">
                    <FontIcon iconLiteral="fth-settings" iconSize="20" styleClass="nav-icon" />
                    <Label text="Settings" styleClass="nav-text" />
                </HBox>
                <HBox fx:id="navSupport" styleClass="nav-item" onMouseClicked="#handleNavClick">
                    <FontIcon iconLiteral="fth-help-circle" iconSize="20" styleClass="nav-icon" />
                    <Label text="Support" styleClass="nav-text" />
                </HBox>
                <HBox styleClass="nav-item" onMouseClicked="#handleBackToHMS">
                    <FontIcon iconLiteral="fth-arrow-left" iconSize="20" styleClass="nav-icon" />
                    <Label text="Back to HMS" styleClass="nav-text" />
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox VBox.vgrow="ALWAYS">
            <HBox styleClass="header-bar" alignment="CENTER_LEFT">
                <Label fx:id="headerTitle" text="MedInventory Pro" styleClass="header-title" />
                <Region prefWidth="20" />
                <HBox fx:id="headerSearchContainer" alignment="CENTER_LEFT" spacing="8" styleClass="search-bar-container" HBox.hgrow="ALWAYS" maxWidth="400">
                    <FontIcon iconLiteral="fth-search" styleClass="search-icon" />
                    <TextField fx:id="searchField" promptText="Search SKU, Batch, or Item..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="16" styleClass="profile-container">
                    <Button styleClass="window-btn">
                        <graphic>
                            <FontIcon iconLiteral="fth-bell" iconSize="18" iconColor="#64748b" />
                        </graphic>
                    </Button>
                    <Button styleClass="window-btn">
                        <graphic>
                            <FontIcon iconLiteral="fth-help-circle" iconSize="18" iconColor="#64748b" />
                        </graphic>
                    </Button>
                    <Separator orientation="VERTICAL" prefHeight="24" />
                    <HBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="profile-avatar">
                            <FontIcon iconLiteral="fth-user" iconSize="16" iconColor="#475569" />
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                            <Label fx:id="profileNameLabel" text="Dr. Sarah Chen" styleClass="profile-name" />
                            <Label fx:id="profileRoleLabel" text="CHIEF PHARMACIST" styleClass="profile-role" />
                        </VBox>
                    </HBox>
                </HBox>
            </HBox>
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;" />
        </VBox>
    </center>
</BorderPane>