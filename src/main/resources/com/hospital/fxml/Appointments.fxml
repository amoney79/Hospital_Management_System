<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hospital.controllers.AppointmentsController" 
            fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
    <VBox spacing="24" style="-fx-padding: 0 0 32 0;">
        
        <BorderPane>
            <left>
                <VBox spacing="4">
                    <Label text="Appointments" styleClass="page-title"/>
                    <Label text="Manage patient appointments" styleClass="page-subtitle"/>
                </VBox>
            </left>
            <right>
                <Button text="Schedule Appointment" styleClass="btn btn-primary" onAction="#handleAddAppointment" BorderPane.alignment="CENTER">
                    <graphic>
                        <FontIcon iconLiteral="fth-plus" styleClass="btn-icon"/>
                    </graphic>
                </Button>
            </right>
        </BorderPane>

        <HBox styleClass="search-bar-container" alignment="CENTER_LEFT" spacing="10">
            <FontIcon iconLiteral="fth-search" styleClass="search-icon"/>
            <TextField promptText="Search appointments by patient or doctor..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox fx:id="appointmentsContainer" spacing="16">
            <!-- Appointment list cards injected here -->
        </VBox>
        
    </VBox>
</ScrollPane>
