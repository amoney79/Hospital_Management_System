<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.hospital.controllers.OutpatientController"
    spacing="16" style="-fx-padding: 24;">
    <Label text="Outpatient Details" styleClass="page-title"/>

    <HBox spacing="12">
        <Label text="Visit Date:"/>
        <Label fx:id="visitDateLabel"/>
    </HBox>

    <HBox spacing="12">
        <Label text="Consultation Type:"/>
        <Label fx:id="consultationTypeLabel"/>
    </HBox>

    <HBox spacing="12">
        <Label text="Doctor Assigned:"/>
        <Label fx:id="doctorLabel"/>
    </HBox>

    <HBox spacing="12">
        <Label text="Next Appointment:"/>
        <Label fx:id="nextAppointmentLabel"/>
    </HBox>
</VBox>
