<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.hospital.inventory.OrdersController"
    spacing="24" style="-fx-padding: 32;" styleClass="main-content">

    <!-- Page Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Orders &amp; Procurement" styleClass="page-title" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="8">
            <Button text="Filter" styleClass="btn btn-outline" />
            <Button text="Export CSV" styleClass="btn btn-outline" />
        </HBox>
    </HBox>

    <!-- Stats Overview -->
    <HBox spacing="16">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="250">
            <HBox alignment="CENTER_LEFT">
                <Label text="BUDGET UTILIZATION (Q3)" styleClass="stat-label" />
                <Region HBox.hgrow="ALWAYS" />
                <FontIcon iconLiteral="fth-credit-card" iconSize="20" styleClass="text-primary" />
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="\$142,500" styleClass="stat-value" />
                <Label text="/ $200k" styleClass="text-muted" />
            </HBox>
            <ProgressBar progress="0.71" maxWidth="Infinity" style="-fx-padding: 8 0 0 0;" />
            <Label text="71% of quarterly clinical supply budget consumed"
                styleClass="text-sm text-muted" wrapText="true" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="12" styleClass="stat-value" style="-fx-text-fill: #005eb8;" />
            <Label text="Drafts" styleClass="text-sm text-muted" />
            <Label text="PENDING ACTION" styleClass="badge badge-neutral" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER"
            style="-fx-border-color: #00478d; -fx-border-width: 0 0 0 4px;">
            <Label text="28" styleClass="stat-value" style="-fx-text-fill: #00478d;" />
            <Label text="Sent/Pending" styleClass="text-sm text-muted" />
            <Label text="OUT FOR APPROVAL" styleClass="badge badge-primary" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="15" styleClass="stat-value" style="-fx-text-fill: #005eb8;" />
            <Label text="Shipped" styleClass="text-sm text-muted" />
            <Label text="IN TRANSIT" styleClass="badge badge-success" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="84" styleClass="stat-value" style="-fx-text-fill: #005eb8;" />
            <Label text="Received (MTD)" styleClass="text-sm text-muted" />
            <Label text="INVENTORY UPDATED" styleClass="badge badge-neutral" />
        </VBox>
    </HBox>

    <!-- Main Data Grid -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 16;">
            <Label text="Purchase Orders" styleClass="title-lg" />
        </HBox>
        <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colOrderId" text="ORDER ID" prefWidth="120" />
                <TableColumn fx:id="colSupplier" text="SUPPLIER" prefWidth="200" />
                <TableColumn fx:id="colSkus" text="SKUS" prefWidth="80" />
                <TableColumn fx:id="colTotalValue" text="TOTAL VALUE" prefWidth="120" />
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120" />
                <TableColumn fx:id="colExpectedDelivery" text="EXPECTED DELIVERY" prefWidth="150" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_LEFT" styleClass="pagination-bar" style="-fx-padding: 16;">
            <Label text="Showing 4 of 124 orders" styleClass="text-sm text-muted" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="4" alignment="CENTER">
                <Button text="&lt;" styleClass="btn btn-outline btn-sm" disable="true" />
                <Button text="1" styleClass="btn btn-primary btn-sm" />
                <Button text="2" styleClass="btn btn-ghost btn-sm" />
                <Button text="3" styleClass="btn btn-ghost btn-sm" />
                <Button text="&gt;" styleClass="btn btn-outline btn-sm" />
            </HBox>
        </HBox>
    </VBox>
</VBox>