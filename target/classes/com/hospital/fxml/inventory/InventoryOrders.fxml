<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hospital.inventory.OrdersController"
    style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">

    <VBox spacing="24" style="-fx-padding: 32;" styleClass="main-content">
        <!-- Stats Overview -->
        <HBox spacing="16">
            <!-- Budget utilization (double width) -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="300">
                <HBox alignment="CENTER_LEFT">
                    <Label text="BUDGET UTILIZATION (Q3)" styleClass="stat-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <FontIcon iconLiteral="fth-credit-card" iconSize="18" iconColor="#00478d" />
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="6" style="-fx-padding: 8 0 0 0;">
                    <Label text="\$142,500" styleClass="stat-value" />
                    <Label text="/ $200k" styleClass="text-muted" style="-fx-font-weight: bold; -fx-padding: 0 0 4 0;" />
                </HBox>
                <ProgressBar progress="0.71" maxWidth="Infinity" style="-fx-padding: 4 0;" />
                <Label text="71% of quarterly clinical supply budget consumed"
                    styleClass="text-sm text-muted" wrapText="true" />
            </VBox>

            <!-- Drafts -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="10">
                <Label text="12" styleClass="stat-value" style="-fx-text-fill: #475569;" />
                <Label text="Drafts" styleClass="text-sm text-muted" />
                <Label text="PENDING ACTION" styleClass="badge badge-neutral" />
            </VBox>

            <!-- Sent/Pending -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="10"
                style="-fx-border-color: #00478d; -fx-border-width: 0 0 0 4px;">
                <Label text="28" styleClass="stat-value" style="-fx-text-fill: #00478d;" />
                <Label text="Sent/Pending" styleClass="text-sm text-muted" />
                <Label text="OUT FOR APPROVAL" styleClass="badge badge-primary" />
            </VBox>

            <!-- Shipped -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="10">
                <Label text="15" styleClass="stat-value" style="-fx-text-fill: #15803d;" />
                <Label text="Shipped" styleClass="text-sm text-muted" />
                <Label text="IN TRANSIT" styleClass="badge badge-success" />
            </VBox>

            <!-- Received -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="10">
                <Label text="84" styleClass="stat-value" style="-fx-text-fill: #475569;" />
                <Label text="Received (MTD)" styleClass="text-sm text-muted" />
                <Label text="INVENTORY UPDATED" styleClass="badge badge-neutral" />
            </VBox>
        </HBox>

        <!-- Main Data Grid -->
        <VBox VBox.vgrow="ALWAYS" styleClass="card" style="-fx-padding: 12;">
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 8 16 16 16;">
                <Label text="Purchase Orders" styleClass="card-title" style="-fx-font-size: 16px;" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="8">
                    <Button text="Filter" styleClass="btn btn-outline" style="-fx-padding: 4 12; -fx-font-size: 12px;">
                        <graphic>
                            <FontIcon iconLiteral="fth-filter" iconSize="12"/>
                        </graphic>
                    </Button>
                    <Button text="Export CSV" styleClass="btn btn-outline" style="-fx-padding: 4 12; -fx-font-size: 12px;">
                        <graphic>
                            <FontIcon iconLiteral="fth-download" iconSize="12"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colOrderId" text="ORDER ID" prefWidth="120" />
                    <TableColumn fx:id="colSupplier" text="SUPPLIER" prefWidth="250" />
                    <TableColumn fx:id="colSkus" text="SKUS" prefWidth="100" />
                    <TableColumn fx:id="colTotalValue" text="TOTAL VALUE" prefWidth="120" />
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120" />
                    <TableColumn fx:id="colExpectedDelivery" text="EXPECTED DELIVERY" prefWidth="150" />
                    <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" styleClass="pagination-bar" style="-fx-padding: 12 16 4 16;">
                <Label text="Showing 4 of 124 orders" styleClass="text-sm text-muted" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="4" alignment="CENTER">
                    <Button text="&lt;" styleClass="btn btn-outline btn-sm" disable="true" style="-fx-padding: 4 8;" />
                    <Button text="1" styleClass="btn btn-primary btn-sm" style="-fx-background-color: #00478d; -fx-text-fill: white; -fx-padding: 4 8;" />
                    <Button text="2" styleClass="btn btn-ghost btn-sm" style="-fx-padding: 4 8;" />
                    <Button text="3" styleClass="btn btn-ghost btn-sm" style="-fx-padding: 4 8;" />
                    <Button text="&gt;" styleClass="btn btn-outline btn-sm" style="-fx-padding: 4 8;" />
                </HBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>