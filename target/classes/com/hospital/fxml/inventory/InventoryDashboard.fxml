<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hospital.inventory.InventoryDashboardController"
    style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">

    <VBox spacing="24" style="-fx-padding: 32;" styleClass="main-content">
        <!-- Top Stats -->
        <HBox spacing="16">
            <!-- Total Inventory -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="TOTAL INVENTORY" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <FontIcon iconLiteral="fth-archive" iconSize="20" iconColor="#00478d"/>
                </HBox>
                <Label fx:id="totalInventoryLabel" text="12,842" styleClass="stat-value" />
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <FontIcon iconLiteral="fth-trending-up" iconSize="12" iconColor="#16a34a"/>
                    <Label text="+2.4% vs last week" styleClass="stat-indicator-positive" />
                </HBox>
            </VBox>

            <!-- Low Stock Alerts -->
            <VBox styleClass="stat-card stat-card-critical" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="LOW STOCK ALERTS" styleClass="stat-label" style="-fx-text-fill: #ba1a1a;" />
                    <Region HBox.hgrow="ALWAYS"/>
                    <FontIcon iconLiteral="fth-alert-triangle" iconSize="20" iconColor="#ba1a1a" />
                </HBox>
                <Label fx:id="lowStockLabel" text="18" styleClass="stat-value" style="-fx-text-fill: #ba1a1a;" />
                <Label text="Requires immediate action" styleClass="text-sm" style="-fx-text-fill: #ba1a1a;" />
            </VBox>

            <!-- Pending Orders -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="PENDING ORDERS" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <FontIcon iconLiteral="fth-truck" iconSize="20" iconColor="#64748b" />
                </HBox>
                <Label fx:id="pendingOrdersLabel" text="07" styleClass="stat-value" />
                <Label text="3 expected today" styleClass="text-sm text-muted" />
            </VBox>

            <!-- Storage Utilization -->
            <VBox styleClass="stat-card stat-card-blue" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="STORAGE UTILIZATION" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <FontIcon iconLiteral="fth-pie-chart" iconSize="20" iconColor="white" />
                </HBox>
                <Label text="84%" styleClass="stat-value" />
                <ProgressBar fx:id="storageProgress" progress="0.84" maxWidth="Infinity"
                    style="-fx-accent: white; -fx-control-inner-background: rgba(255,255,255,0.2);" />
            </VBox>
        </HBox>

        <!-- Consumption trends and Right sidebar -->
        <HBox spacing="24" VBox.vgrow="ALWAYS">
            <!-- Main Area: Chart -->
            <VBox spacing="24" HBox.hgrow="ALWAYS">
                <VBox styleClass="card" VBox.vgrow="ALWAYS" style="-fx-padding: 24;">
                    <HBox alignment="CENTER">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Consumption Trends" styleClass="title-lg" />
                            <Label text="Monthly pharmaceutical usage vs delivery volume"
                                styleClass="text-sm text-muted" />
                        </VBox>
                        <HBox spacing="8">
                            <Button text="Weekly" styleClass="btn btn-outline btn-sm" />
                            <Button text="Monthly" styleClass="btn btn-primary btn-sm" style="-fx-background-color: #00478d;"/>
                        </HBox>
                    </HBox>
                    <Region prefHeight="16" />
                    <!-- Visual Chart Container -->
                    <StackPane fx:id="chartPlaceholder" VBox.vgrow="ALWAYS" minHeight="300" />
                </VBox>
            </VBox>

            <!-- Right Sidebar -->
            <VBox spacing="24" prefWidth="350" minWidth="350">
                <!-- Critical Alerts -->
                <VBox styleClass="card" style="-fx-background-color: #ffdad6; -fx-border-color: #ffb4ab; -fx-padding: 16;" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-alert-circle" iconColor="#93000a" iconSize="20" />
                        <Label text="Critical Alerts" style="-fx-text-fill: #93000a; -fx-font-weight: bold; -fx-font-size: 15px;" />
                    </HBox>
                    
                    <VBox spacing="8">
                        <HBox styleClass="card" style="-fx-background-color: white; -fx-padding: 12;" alignment="CENTER_LEFT" spacing="10">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Insulin Aspart (R-102)" styleClass="font-bold text-sm" />
                                <Label text="Stock: 02 Units (Min: 50)" style="-fx-text-fill: #ba1a1a; -fx-font-size: 11px;" />
                            </VBox>
                            <Button text="REORDER" styleClass="btn btn-ghost btn-sm" style="-fx-text-fill: #00478d; -fx-font-weight: bold;" />
                        </HBox>
                        
                        <HBox styleClass="card" style="-fx-background-color: white; -fx-padding: 12;" alignment="CENTER_LEFT" spacing="10">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Epinephrine 1mg/ml" styleClass="font-bold text-sm" />
                                <Label text="Stock: 12 Units (Min: 40)" style="-fx-text-fill: #ba1a1a; -fx-font-size: 11px;" />
                            </VBox>
                            <Button text="REORDER" styleClass="btn btn-ghost btn-sm" style="-fx-text-fill: #00478d; -fx-font-weight: bold;" />
                        </HBox>

                        <HBox styleClass="card" style="-fx-background-color: white; -fx-padding: 12;" alignment="CENTER_LEFT" spacing="10">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Sodium Chloride 0.9%" styleClass="font-bold text-sm" />
                                <Label text="Stock: 142 Units (Min: 500)" style="-fx-text-fill: #ba1a1a; -fx-font-size: 11px;" />
                            </VBox>
                            <Button text="REORDER" styleClass="btn btn-ghost btn-sm" style="-fx-text-fill: #00478d; -fx-font-weight: bold;" />
                        </HBox>
                    </VBox>
                    <HBox alignment="CENTER">
                        <Label text="View All 18 Alerts" style="-fx-text-fill: #93000a; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand;" />
                    </HBox>
                </VBox>

                <!-- System Upgrade Card -->
                <StackPane styleClass="card" VBox.vgrow="ALWAYS" style="-fx-background-color: #2e3037; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 0;" maxHeight="150" minHeight="150">
                    <ImageView fitWidth="350" fitHeight="150" smooth="true">
                        <image>
                            <Image url="@../../images/inventory_upgrade_bg.png" />
                        </image>
                    </ImageView>
                    <VBox alignment="BOTTOM_LEFT" spacing="6" style="-fx-background-color: rgba(15,23,42,0.65); -fx-padding: 16; -fx-background-radius: 12; -fx-border-radius: 12;">
                        <Label text="Inventory System Upgrade" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        <Label text="Scheduled for Oct 12, 22:00 EST" style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;" />
                    </VBox>
                </StackPane>
            </VBox>
        </HBox>

        <!-- Bottom Table: Recent Inventory Activity -->
        <VBox styleClass="card" style="-fx-padding: 24;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Recent Inventory Activity" styleClass="title-lg" />
                </VBox>
                <Label text="Last updated: 14:22 Today" styleClass="text-sm text-muted" />
                <FontIcon iconLiteral="fth-filter" iconSize="16" iconColor="#64748b" style="-fx-cursor: hand;" />
            </HBox>
            <Region prefHeight="16" />
            <TableView fx:id="recentActivityTable" prefHeight="200" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSkuItemName" text="SKU / ITEM NAME" prefWidth="300" />
                    <TableColumn fx:id="colActionType" text="ACTION TYPE" prefWidth="150" />
                    <TableColumn fx:id="colBatchNo" text="BATCH NO." prefWidth="150" />
                    <TableColumn fx:id="colQuantity" text="QUANTITY" prefWidth="120" />
                    <TableColumn fx:id="colStaffEntity" text="STAFF ENTITY" prefWidth="180" />
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>