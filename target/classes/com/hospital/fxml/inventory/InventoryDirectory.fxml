<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.hospital.inventory.DirectoryController" 
      spacing="24" style="-fx-padding: 32;" styleClass="main-content">
    
    <!-- Page Header -->
    <HBox alignment="BOTTOM_LEFT" spacing="10">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Inventory" styleClass="breadcrumb"/>
                <FontIcon iconLiteral="fth-chevron-right" iconSize="16" styleClass="breadcrumb-icon"/>
                <Label text="Directory" styleClass="breadcrumb-active"/>
            </HBox>
            <Label text="Inventory Directory" styleClass="page-title"/>
            <Label text="Real-time oversight of surgical, pharmaceutical, and consumable supplies." styleClass="page-subtitle"/>
        </VBox>
        <Button text="Add New Item" styleClass="btn btn-primary" graphicTextGap="8">
            <graphic>
                <FontIcon iconLiteral="fth-plus" iconSize="16"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Stats Overview -->
    <HBox spacing="16">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Total Items" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="14,208" styleClass="stat-value"/>
                <Label text="↑ 2.4%" styleClass="stat-indicator-positive"/>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Low Stock Alerts" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="12" styleClass="stat-value" style="-fx-text-fill: #ba1a1a;" />
                <Label text="CRITICAL" styleClass="badge badge-critical"/>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Expiring Soon" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="84" styleClass="stat-value"/>
                <Label text="Next 30 days" styleClass="text-sm text-muted" style="-fx-padding: 0 0 4 0;"/>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Pending Orders" styleClass="stat-label"/>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <Label text="06" styleClass="stat-value"/>
                <Label text="View Track" styleClass="text-sm" style="-fx-text-fill: #00478d; -fx-underline: true; -fx-cursor: hand; -fx-padding: 0 0 4 0;"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Filter Controls -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filter-bar" style="-fx-background-color: #f1f5f9; -fx-padding: 12; -fx-background-radius: 8;">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="filter-group">
            <FontIcon iconLiteral="fth-filter" iconSize="16" styleClass="filter-icon" iconColor="#64748b"/>
            <Label text="Filter By" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13px;"/>
        </HBox>
        <ComboBox promptText="All Categories" styleClass="filter-combo" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;"/>
        <ComboBox promptText="All Stock Levels" styleClass="filter-combo" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;"/>
        <ComboBox promptText="Any Expiration" styleClass="filter-combo" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-cursor: hand;">
            <FontIcon iconLiteral="fth-refresh-ccw" iconSize="14" iconColor="#00478d"/>
            <Label text="Clear All Filters" style="-fx-text-fill: #00478d; -fx-font-weight: bold; -fx-font-size: 13px;"/>
        </HBox>
    </HBox>

    <!-- Main Data Grid -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card" style="-fx-padding: 12;">
        <TableView fx:id="directoryTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colItemName" text="ITEM NAME" prefWidth="280"/>
                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="120"/>
                <TableColumn fx:id="colSku" text="SKU / BARCODE" prefWidth="150"/>
                <TableColumn fx:id="colStockLevel" text="STOCK LEVEL" prefWidth="120"/>
                <TableColumn fx:id="colExpiration" text="EXPIRATION" prefWidth="120"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_LEFT" styleClass="pagination-bar" style="-fx-padding: 12 16 4 16;">
            <Label text="Showing 1 - 25 of 1,402 items" styleClass="text-sm text-muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4" alignment="CENTER">
                <Button text="&lt;" styleClass="btn btn-outline btn-sm" disable="true" style="-fx-padding: 4 8;"/>
                <Button text="1" styleClass="btn btn-primary btn-sm" style="-fx-background-color: #00478d; -fx-text-fill: white; -fx-padding: 4 8;"/>
                <Button text="2" styleClass="btn btn-ghost btn-sm" style="-fx-padding: 4 8;"/>
                <Button text="3" styleClass="btn btn-ghost btn-sm" style="-fx-padding: 4 8;"/>
                <Label text="..." styleClass="text-sm text-muted" style="-fx-padding: 0 4;"/>
                <Button text="56" styleClass="btn btn-ghost btn-sm" style="-fx-padding: 4 8;"/>
                <Button text="&gt;" styleClass="btn btn-outline btn-sm" style="-fx-padding: 4 8;"/>
            </HBox>
        </HBox>
    </VBox>
</VBox>
